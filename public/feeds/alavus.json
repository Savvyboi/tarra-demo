{"meta":{"count":6,"total_upstream":9,"coverage_start":"2026-10-29","coverage_end":"2026-12-15","next":null,"previous":null,"generated_at":"2026-10-28T22:39:56.958Z","source_calendar":"https://epkalenteri.linkedevents.fi/v1/","source_id":"ep_linkedevents","coordinate_corrections":9},"data":[{"id":"ep:eptapahtumat:agpyjc6nfy","data_source":"alavus","publisher":"EP Kalenteri","name":{"fi":"Kennelliiton lukukoira Häjy Alavuden kirjastossa"},"short_description":{"fi":"Tule lukemaan lukukoira Häjylle!"},"description":{"fi":"<p>Lukukoira Häjy kuuntelee lukijoita Alavuden pääkirjastolla parittomien viikkojen torstaisin klo 17-18.</p> <p>13.8.</p>\n<p>27.8.</p>\n<p>10.9.</p>\n<p>24.9.</p>\n<p>8.10.</p>\n<p>22.10.</p>\n<p>5.11.</p>\n<p>19.11.</p> <p>Voit varata 15 minuutin lukuajan ottamalla yhteyttä pääkirjastoon. Kirjaston asiakaspalvelunumero on 06 25251594.</p> <p>Häjy on rauhallinen koira, joka kuuntelee mielellään epävarmaakin lukijaa. Sitä ei haittaa mahdolliset virheet tai puuttuvat äänteet, vaan lukija saa tulla sellaisena kuin on.</p> <p>Häjy on kennelliiton hyväksymä lukukoira.</p>"},"start_time":"2026-11-05T15:00:00.000Z","end_time":"2026-11-05T16:00:00.000Z","super_event":{"id":"http://epkalenteri.linkedevents.fi/v1/event/eptapahtumat:agpyjc57am/"},"provider":{"fi":"Alavuden kaupunginkirjasto"},"info_url":{"en":"https://epkalenteri.fi/event/eptapahtumat:agpyjc57am"},"offers":[{"is_free":true,"price":null,"info_url":null}],"location":{"id":"eptapahtumat:afrbsyuxnq","name":{"fi":"Alavuden kirjasto"},"street_address":{"fi":"Järviluomantie 3"},"address_locality":{"fi":"Alavus"},"position":{"type":"Point","coordinates":[23.617553,62.585648]},"coordinate_swapped":true},"keywords":[{"id":"eptapahtumat:qyupevyuro","name":{"en":"Library"}}],"images":[{"id":194726,"url":"https://dsre702v2imo2.cloudfront.net/event-images/9kq962mrulcim7_H%C3%A4jy-40.jpg","license":"cc_by"}],"occurrence_dates":[{"id":"ep:eptapahtumat:agpyjc6mue","start":"2026-11-05T15:00:00.000Z","end":"2026