uustinna/"},"offers":[{"is_free":false,"price":{"en":"38,50 €"},"info_url":null}],"location":{"id":"saarijarvi:loc-25.2723-62.7028","name":{"fi":"Saarijärvi"},"street_address":{"en":"Paavontie 1, Saarijärvi"},"position":{"type":"Point","coordinates":[25.272349,62.702846]}},"keywords":[{"id":"25d944db-1286-4eea-891f-686579707bc9","name":{"en":"Food and drink"}},{"id":"8ca34f53-e8cb-4643-b1f9-e14ab65268be"}],"images":[{"id":"fb03ff6e-43b4-4ffd-81bf-530e3ace623c","url":"https://keskisuomievents.fi/api/assets/2e7e11e8-3aab-473e-addf-46f966530b10?key=public","alt_text":"Ruustinna Father's Day Warm-Up event featuring a festive dining table with abundant food and seasonal dishes. The image includes the event name, date (November 7), and Ruustinna's contact details.","license":"event_only"}],"occurrence_dates":[{"id":"ks:5ec43aca-9133-46c1-be55-19a8e54f84cf","start":"2026-11-07T14:30:00.000Z","end":"2026-11-07T19:30:00.000Z","info_url":{"en":"https://www.instagram.com/ruustinna/"}}]},{"id":"ks:c8dc9a82-8e49-4bea-ab55-dc792a336b50","data_source":"saarijarvi","publisher":"keskisuomievents","name":{"fi":"Maxim Fedorov vierailee Saarijärvellä"},"short_description":{"fi":"Suomea ahkerasti kiertänyt toimittaja ja tietokirjailija saapuu Saarijärven koulu- ja kulttuurikeskukseen kertomaan työstään ja kirjoistaan."},"description":{"fi":"Suomea ahkerasti kiertänyt toimittaja ja tietokirjailija Maxim Fedorov (s. 1985) saapuu Saarijärven koulu- ja kulttuurikeskukseen (Lukiontie 3) kertomaan työstään ja kirjoistaan tiistaina 10.11.2026 klo 18.00. Saarijärven kaupungin, Saarijärven kaupunginkirjaston ja Saarijärven museon ystävät ry:n yhteistyössä järjestämään tilaisuuteen on vapaa pääsy. Lämpimästi tervetuloa! Maxim Fedorov aloitti työskentelyn Ylellä vuonna 2013 venäjänkielisten uutisten toimittajana. Venäjän hyökättyä Ukrainaan hän muutti Kiovaan Ylen ulkomaankirjeenvaihtajaksi. Fedorov on syntynyt ja kasvanut Pietarissa, mutta lapsuuskesiään hän vietti Etelä-Ukrainassa äitinsä suvun luona. Kymmentä kieltä hallitseva Fedorov on valmistunut Helsingin yliopistosta suomen kielen ja kulttuurin maisteriksi. Hän on julkaissut kirjat Minun Ukrainani (2023), Sodan näyttämöt (2024), Itsenäisyydestä itsenäisyyteen. Suomi ja Ukraina 1917–1991 (2025), Ukrainan kielioppi (2026) ja Suomi: Ylipitkä oppimäärä (2026)."},"start_time":"2026-11-10T16:00:00.000Z","end_time":"2026-11-10T18:00:00.000Z","provider":{"en":"Saarijärven kaupunginkirjasto"},"info_url":{"en":"https://kalenteri.jyvaskyla.fi/event/c8dc9a82-8e49-4bea-ab55-dc792a336b50"},"location_extra_info":{"fi":"Saarijärven koulu- ja kulttuurikeskus, Kulttuuritori"},"location":{"id":"saarijarvi:loc-25.2550-62.7060","name":{"fi":"Saarijärvi"},"street_address":{"en":"Lukiontie 3, Saarijärvi"},"position":{"type":"Point","coordinates":[25.255038,62.706017]}},"keywords":[{"id":"c1962289-2bad-4171-bde1-43090af052e2","name":{"en":"Literature"}},{"id":"810f7e9d-c372-4f27-bc2f-ce7ea7b4f058","name":{"en":"Free entry"}},{"id":"1ec6d224-5fd6-4e7a-8dc9-674478a634c6"},{"id":"8ca34f53-e8cb-4643-b1f9-e14ab65268be"}],"images":[{"id":"8d1e875e-0990-4daf-8636-0236124a0e34","url":"https://keskisuomievents.fi/api/assets/8c526e42-fd84-436b-b312-fded33b5903d?key=public","photographer_name":"© Petri Mast / Docendo","alt_text":"Maxim Fedorov kuvattuna metsässä.","license":"event_only"}],"occurrence_dates":[{"id":"ks:c8dc9a82-8e49-4bea-ab55-dc792a336b50","start":"2026-11-10T16:00:00.000Z","end":"2026-11-10T18:00:00.000Z","info_url":{"en":"https://kalenteri.jyvaskyla.fi/event/c8dc9a82-8e49-4bea-ab55-dc792a336b50"}}]},{"id":"ks:bc78c7fd-c621-4b1c-853d-bf3e63c87611","data_source":"saarijarvi","publisher":"keskisuomievents","name":{"fi":"Hymyn Joulutapahtuma","en":"\"Hymyn Christmas Event\""},"short_description":{"en":"Warm welcome to the whole family to the atmospheric Hymyn Christmas event that has become a tradition at Puuhapuisto Veijari on Saturday 5.12 at 4:30 PM - 7:30 PM."},"description":{"en":"In the twilight of the evening, candles and lanterns illuminate the park, come and peek at what Christmas means for alpacas, goats, pigs, ponies, donkeys and miniature horses. At the Christmas event you also get to meet Santa Claus and an elf :) If you wish, bring your own lantern and elf hat and walk along the candlelit route! At the event on sale including delicious rice porridge (all almond finders will be rewarded), mulled wine, gingerbread and sausage. Also in store including an almond competition, elf hunt and Christmas program. Pekka Pokela is responsible for Christmas music at the cabin. If you want to join the event to sell your own products, contact info@puuhapuistoveijari.fi. Admission is FREE!! The program will be confirmed closer to the event date, follow the announcements on social media. Warmly welcome! The event is organized together by the business group project Hymyn (Wellness tourism through cooperation) companies: Äärelläsi, Jakolan tila, Saarijärven Ruustinna and Puuhapuisto Veijari"},"start_time":"2026-12-05T14:30:00.000Z","end_time":"2026-12-05T17:30:00.000Z","provider":{"en":"Puuhapuisto Veijari"},"info_url":{"en":"https://www.facebook.com/events/1630655621853767"},"location":{"id":"saarijarvi:loc-25.1726-62.7402","name":{"fi":"Saarijärvi"},"street_address":{"en":"Puistotie 1, SaarijärviKolkanlahti"},"position":{"type":"Point","coordinates":[25.172614,62.740182]}},"keywords":[{"id":"43ddc4b9-f7b9-4394-928e-e95562c23634","name":{"en":"Christmas"}},{"id":"202c9a07-62c6-4351-9392-e67cacef1c7f","name":{"en":"Other"}},{"id":"810f7e9d-c372-4f27-bc2f-ce7ea7b4f058","name":{"en":"Free entry"}},{"id":"96b1d271-7512-4fee-bc75-ee60a966d3a9"},{"id":"8ca34f53-e8cb-4643-b1f9-e14ab65268be"},{"id":"b5abe251-ee1e-4814-a1b3-5e868c3445fa"}],"images":[{"id":"10b5554a-6e04-46ad-ad1e-90571d18edb0","url":"https://keskisuomievents.fi/api/assets/571a578c-fefe-4952-83d1-43a8352e2731?key=public","license":"event_only"}],"occurrence_dates":[{"id":"ks:bc78c7fd-c621-4b1c-853d-bf3e63c87611","start":"2026-12-